<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>scalus-ui</AssemblyName>
    <RootNamespace>OneIdentity.Scalus.Ui</RootNamespace>
    <ApplicationIcon>..\scalus.ico</ApplicationIcon>
    <NoWarn>1701;1702;CA1416</NoWarn>
    <UiSourceDir>$(MSBuildProjectDirectory)\..\..\ui</UiSourceDir>
    <UiDistDir>$(UiSourceDir)\dist\scalus-ui\browser</UiDistDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneIdentity.Scalus.csproj" />
  </ItemGroup>

  <!-- Dev convenience (Debug only): build the CLI launcher first so a fresh scalus.exe can be
       staged beside scalus-ui.exe (see StageLauncherCli). The all-users elevation broker shells
       out to a sibling scalus.exe; without this, local edits to the core registrar logic wouldn't
       reach the elevated helper until the CLI was rebuilt by hand. Production packaging ships a
       NativeAOT scalus.exe via the installer, so this is intentionally scoped to Debug builds. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Cli\Scalus.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Shipped default configurations used to seed a fresh per-user install. -->
  <ItemGroup>
    <Content Include="..\scalus.ico" Link="scalus.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Win\SCALUS.json" Link="defaults\windows.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Osx\SCALUS.json" Link="defaults\mac.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Linux\SCALUS.json" Link="defaults\linux.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Track the Angular sources so edits to templates/styles/ts trigger a rebuild
       instead of being skipped because dist/index.html happens to be newer than package.json. -->
  <ItemGroup>
    <AngularSources Include="$(UiSourceDir)\src\**\*" />
  </ItemGroup>

  <!-- Build the Angular front-end and stage it into the output as wwwroot. The web
       assets are a build product, never checked in. -->
  <Target Name="BuildAngularUi" BeforeTargets="Build" Inputs="$(UiSourceDir)\package.json;$(UiSourceDir)\angular.json;$(UiSourceDir)\tsconfig.json;@(AngularSources)" Outputs="$(UiDistDir)\index.html">
    <Message Importance="high" Text="Installing Angular dependencies..." Condition="!Exists('$(UiSourceDir)\node_modules')" />
    <Exec Command="npm ci" WorkingDirectory="$(UiSourceDir)" Condition="!Exists('$(UiSourceDir)\node_modules')" />
    <Message Importance="high" Text="Building Angular front-end..." />
    <Exec Command="npm run build" WorkingDirectory="$(UiSourceDir)" />
  </Target>

  <Target Name="StageAngularUi" AfterTargets="Build">
    <ItemGroup>
      <AngularArtifacts Include="$(UiDistDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AngularArtifacts)"
          DestinationFiles="@(AngularArtifacts->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageAngularUiForPublish" AfterTargets="Publish">
    <ItemGroup>
      <AngularArtifactsPublish Include="$(UiDistDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AngularArtifactsPublish)"
          DestinationFiles="@(AngularArtifactsPublish->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Stage the freshly-built CLI launcher beside scalus-ui.exe for local (Debug) runs so the
       all-users elevation broker invokes current core logic. Every dependency assembly the
       framework-dependent launcher needs is already in this output (both projects reference the
       same core), so only the launcher's own four files are copied. Cross-platform: the apphost is
       scalus.exe on Windows and extensionless scalus elsewhere; whichever exists is staged. -->
  <Target Name="StageLauncherCli" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <CliOutDir>$(MSBuildProjectDirectory)\..\Cli\bin\$(Configuration)\$(TargetFramework)\</CliOutDir>
    </PropertyGroup>
    <ItemGroup>
      <LauncherFiles Include="$(CliOutDir)scalus.dll;$(CliOutDir)scalus.runtimeconfig.json;$(CliOutDir)scalus.deps.json" />
      <LauncherFiles Include="$(CliOutDir)scalus.exe" Condition="Exists('$(CliOutDir)scalus.exe')" />
      <LauncherFiles Include="$(CliOutDir)scalus" Condition="Exists('$(CliOutDir)scalus')" />
    </ItemGroup>
    <Copy SourceFiles="@(LauncherFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CliOutDir)scalus.dll')" />
  </Target>

</Project>
